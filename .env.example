# P-TRANSMIT AI — example environment configuration
# Copy to backend/.env and edit values. NEVER commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite (default, zero-config). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ptransmit
DATABASE_URL=sqlite:///backend/data/ptransmit.db

# Auto-load the clearly-labelled synthetic demonstration dataset on first start
DEMO_MODE=true

# Comma-separated origins allowed by CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload size in MB
MAX_UPLOAD_MB=50

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480
